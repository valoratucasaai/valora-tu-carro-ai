# ---------------------------------------------------------------------------
# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.
# Son las MISMAS llaves de Bold que usa Valora tu casa.AI.
# ---------------------------------------------------------------------------

# Llave de IDENTIDAD de Bold (pública, viaja al navegador).
BOLD_IDENTITY_KEY=

# Llave SECRETA de Bold (privada, solo servidor). Con esta se firma el hash de integridad.
BOLD_SECRET_KEY=

# Llave secreta del webhook. Si la dejas vacía se usa BOLD_SECRET_KEY.
BOLD_WEBHOOK_SECRET=

# URL pública del sitio, sin barra final. Ej: https://valoratucarro.ai
PUBLIC_URL=http://localhost:3000

# Token propio para consultar /api/admin/orders (invéntalo, largo y aleatorio).
ADMIN_TOKEN=

# Puerto (Render lo inyecta solo; en local puedes dejar 3000)
PORT=3000

# Carpeta donde se guardan órdenes y fichas. En Render usa el disco: /var/data
DATA_DIR=./data
