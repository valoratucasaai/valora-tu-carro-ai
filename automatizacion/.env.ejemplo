# ---------------------------------------------------------------------------
# Configuracion de la automatizacion de Valora tu carro.AI.
# Copia este archivo como  .env  en la raiz del proyecto del MOTOR (donde estan
# la plantilla, la base de comparables y la carpeta Valoraciones/).
# El .env NUNCA se sube a GitHub.
# ---------------------------------------------------------------------------

# URL publica del sitio, sin barra final.
API_BASE=https://vtc.lat

# El ADMIN_TOKEN del servicio de carros en Render (Environment > ADMIN_TOKEN).
# Lo tiene Juan Pablo.
ADMIN_TOKEN=

# Resend. Misma cuenta que la web de casas; el dominio vtc.lat ya esta verificado.
RESEND_API_KEY=

# Remitente. El dominio tiene que estar verificado en Resend.
CORREO_REMITENTE=informes@vtc.lat

# Recibe copia oculta de cada envio y los avisos de error.
CORREO_INTERNO=valoratucasa.ai@gmail.com
